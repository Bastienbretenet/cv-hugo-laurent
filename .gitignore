# ---------------------------------------------------------------
# Photos de la galerie
#
# Les images d'assets/gallery/ sont versionnées : le mur les affiche
# automatiquement, il suffit d'en déposer une nouvelle dans le dossier.
#
# Seul ori/ est exclu : il garde les photos d'origine (~110 Mo), trop
# lourdes pour le dépôt. Elles ne sont sauvegardées que localement.
# ---------------------------------------------------------------
/assets/gallery/ori/

# ---------------------------------------------------------------
# Métadonnées WSL / Windows
# ---------------------------------------------------------------
*:Zone.Identifier
Thumbs.db
desktop.ini
ehthumbs.db

# ---------------------------------------------------------------
# macOS / Linux
# ---------------------------------------------------------------
.DS_Store
.AppleDouble
.Spotlight-V100
.Trashes
*~
.fuse_hidden*
.nfs*

# ---------------------------------------------------------------
# Éditeurs
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------
# Outils
# ---------------------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.log
scripts
